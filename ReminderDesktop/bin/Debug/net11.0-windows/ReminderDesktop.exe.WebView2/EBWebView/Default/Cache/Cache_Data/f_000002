function getReminderTitle(reminderId) {

    const reminder = savedReminders.find(
        r => r.id === reminderId
    );

    return reminder ? reminder.title : "this task";
}


function submitFinishedProof(reminderId, button) {

    const input =
        document.getElementById(`proof-${reminderId}`);

    if (!input || input.value.trim() === "") {

        alert("Please enter your proof.");

        return;
    }

    if (window.chrome && window.chrome.webview) {

        window.chrome.webview.postMessage({
            type: "reminderCompleted",
            id: reminderId,
            action: "finished",
            proof: input.value.trim()
        });
    }

    button.closest(".reminder-notification").remove();
}

    if (action === "emergency") {

        // Emergency does not require proof.
        if (window.chrome && window.chrome.webview) {

            window.chrome.webview.postMessage({
                type: "reminderCompleted",
                id: reminderId,
                action: "emergency"
            });
        }

        button.closest(".reminder-notification").remove();

        return;
    }

    if (action === "notDone") {

        alert("Not Done selected.");

        return;
    }
}
